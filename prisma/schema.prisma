generator client {
  provider = "prisma-client-js"
  // "native" for local dev, the RHEL target for Vercel's Node runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Transaction pooler (port 6543) - what the serverless functions use.
  url       = env("DATABASE_URL")
  // Session/direct connection (port 5432) - migrations only.
  directUrl = env("DIRECT_URL")
}

model LoanInfo {
  id                  String   @id @default(cuid())
  plafond             Float
  disbursedAmount     Float
  monthlyInstallment  Float
  tenorMonths        Int
  startDate          DateTime
  debtAdjustment     Float    @default(0)
  createdAt          DateTime @default(now())

  loanPayments       LoanPayment[]
}

model LoanPayment {
  id                String   @id @default(cuid())
  loanInfoId        String
  monthNumber       Int
  dueDate           DateTime
  amountDue         Float
  amountPaid        Float
  status            String
  shortfallAmount   Float
  generatedAt       DateTime @default(now())

  loanInfo          LoanInfo @relation(fields: [loanInfoId], references: [id])
  accountTransactions AccountTransaction[]
}

model AccountBalance {
  id              String   @id @default(cuid())
  currentBalance  Float
  updatedAt       DateTime @default(now())
}

model AccountTransaction {
  id                    String   @id @default(cuid())
  transactionDate       DateTime
  type                  String
  amount                Float
  resultingBalance     Float
  relatedLoanPaymentId  String?
  note                  String?
  createdAt            DateTime @default(now())

  relatedLoanPayment   LoanPayment? @relation(fields: [relatedLoanPaymentId], references: [id])
}
