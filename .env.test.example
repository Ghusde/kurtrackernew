# Local Postgres for `npm run test:db`. NEVER point this at Supabase:
# the integration tests TRUNCATE every table, and they refuse to run against
# any host other than localhost.
#
#   docker run -d --name kur-pg -e POSTGRES_PASSWORD=devpass -e POSTGRES_DB=kur \
#     -p 55432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:devpass@localhost:55432/kur"
DIRECT_URL="postgresql://postgres:devpass@localhost:55432/kur"
