# ---------------------------------------------------------------------------
# Supabase Postgres
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Replace [PASSWORD] and [PROJECT-REF]/[REGION] with your own values.
# ---------------------------------------------------------------------------

# Runtime connection used by every serverless function.
# Transaction pooler (port 6543). pgbouncer=true + connection_limit=1 are
# REQUIRED on serverless: each cold start would otherwise open its own pool and
# exhaust Supabase's connection limit.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct/session connection (port 5432) used only by `prisma migrate` and
# `prisma studio`. Migrations cannot run through the transaction pooler.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Local-only. Vercel sets its own PORT; nothing in api/ reads this.
# PORT=4000

# Optional: only needed if you run the frontend against a DIFFERENT origin than
# the API (e.g. `vite` alone pointed at your production deployment). Leave it
# unset for `vercel dev` and for production, where both share one origin.
# VITE_API_URL="https://your-app.vercel.app"
